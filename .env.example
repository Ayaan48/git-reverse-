# ---------------------------------------------------------------------------
# Autonomous CI/CD Healing Agent - environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Anthropic API key. Optional but strongly recommended.
# Without it the agent still runs and applies deterministic fixes, but the
# AI-generated repair tier and AI-assisted failure diagnosis are disabled.
ANTHROPIC_API_KEY=

# Gemini API key (https://aistudio.google.com). Optional. Gives the AI repair
# tier a second model: used as a fallback when Claude is unavailable (no credit,
# bad key, quota), or on its own if no Anthropic key is set.
GEMINI_API_KEY=

# Gemini model id. Google retires ids on its own schedule; if the dashboard
# shows Gemini as "failing: model not found", change this.
HEALING_AGENT_GEMINI_MODEL=gemini-2.5-flash

# Which model repairs first: auto (Claude, then Gemini) | anthropic | gemini
HEALING_AGENT_PROVIDER=auto

# How often (seconds) the background monitor re-checks each configured model.
# Minimum 30. Each check is a tiny request, so the cost is negligible.
HEALING_AGENT_MODEL_CHECK_SECONDS=300

# Model used for repair + diagnosis.
HEALING_AGENT_MODEL=claude-opus-5

# Effort level for the model: low | medium | high | xhigh | max
HEALING_AGENT_EFFORT=high

# Optional server-side fallback GitHub token. The UI supplies a token per
# request; this is only a default for local development and for the
# pipeline-health monitor when no token is posted.
GITHUB_TOKEN=

# Where cloned repositories are checked out. Must be writable.
# On serverless platforms this has to live under /tmp.
HEALING_AGENT_WORKSPACE=.workspaces

# Comma-separated list of allowed CORS origins for the API.
# Use "none" when the dashboard is served by this same process (the Docker and
# Render deployments do this) - requests are then same-origin and no
# cross-origin allowance is needed. Use * only for local development.
HEALING_AGENT_CORS_ORIGINS=*

# Running a submitted repository's test suite EXECUTES that repository's code:
# pytest imports conftest.py and every test module at collection time. Leave
# this false on any deployment where you do not control every repository that
# gets submitted. Turning it on locally, against your own code, is safe and is
# what makes the "tests" validation gate meaningful.
HEALING_AGENT_ALLOW_TEST_EXECUTION=false

# Max number of heal -> validate rounds before the agent stops.
HEALING_AGENT_MAX_ROUNDS=3

# Hard ceiling (seconds) on a single analyze run.
HEALING_AGENT_JOB_TIMEOUT=900

# Max number of files the agent will send to the model in one run.
HEALING_AGENT_MAX_AI_FILES=40

# Statuspage endpoint used for platform-degradation detection.
HEALING_AGENT_STATUS_URL=https://www.githubstatus.com/api/v2/summary.json

# ---------------------------------------------------------------------------
# Persistent incident memory (Hindsight by Vectorize). Optional.
# With no API key the agent runs exactly as before; memory is additive only.
# Get a key at https://hindsight.vectorize.io, then run:
#   python scripts/setup_memory_bank.py   (create the bank)
#   python scripts/seed_memory.py         (optional: load demo incidents)
# ---------------------------------------------------------------------------
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=cicd-healing-agent

# Frontend -> backend base URL. Empty means "same origin" (Vercel rewrites).
VITE_API_BASE_URL=
